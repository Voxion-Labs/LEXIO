{{define "dashboard"}}
            <!-- 1. DASHBOARD VIEW (Default post-login view) -->
            <section id="dashboardView" class="workspace-view active">
                <!-- Hero Banner -->
                <article class="hero-panel">
                    <div style="flex: 1; min-width: 300px;">
                        <span class="badge badge-primary"><i class="fas fa-headphones"></i> Document Speech &amp; Narration</span>
                        <h2>Natural speech for real documents.</h2>
                        <p>
                            LEXIO reads by natural phrases instead of robotic word-by-word steps, filters voices by language, regional accent, and gender (Male/Female), and keeps the document viewer synchronized while speaking.
                        </p>
                    </div>
                    <div class="hero-metrics">
                        <div class="metric-tile">
                            <span class="metric-label">Detected Language</span>
                            <strong id="detectedLanguage">English</strong>
                        </div>
                        <div class="metric-tile">
                            <span class="metric-label">Read Time</span>
                            <strong id="timeEstimate">0s</strong>
                        </div>
                        <div class="metric-tile">
                            <span class="metric-label">Sections</span>
                            <strong id="sectionCount">0</strong>
                        </div>
                        <div class="metric-tile">
                            <span class="metric-label">Words</span>
                            <strong id="wordCount">0</strong>
                        </div>
                    </div>
                </article>

                <!-- Reading Analytics Card -->
                <article class="card dashboard-card">
                    <div class="section-header">
                        <div>
                            <span class="badge badge-info"><i class="fas fa-chart-simple"></i> Reading Analytics</span>
                            <h3 style="margin-top: 6px;">Document Structure &amp; Stats</h3>
                        </div>
                    </div>
                    <div class="insight-grid" style="grid-template-columns: repeat(3, 1fr); gap: 16px;">
                        <div class="insight-tile">
                            <span class="insight-label">Total Characters</span>
                            <strong id="charCount">0</strong>
                        </div>
                        <div class="insight-tile">
                            <span class="insight-label">Document Sections</span>
                            <strong id="docSectionsStat">0</strong>
                        </div>
                        <div class="insight-tile">
                            <span class="insight-label">Speaking Cadence</span>
                            <strong id="docPaceStat">150 wpm</strong>
                        </div>
                    </div>
                    <div style="display: flex; gap: 12px; flex-wrap: wrap; margin-top: 10px;">
                        <button type="button" class="btn btn-primary workspace-tab" data-view="readerView">
                            <i class="fas fa-file-waveform"></i> Open in Reader
                        </button>
                        <button type="button" class="btn btn-secondary workspace-tab" data-view="studioView">
                            <i class="fas fa-tower-broadcast"></i> Open Studio &amp; Telemetry
                        </button>
                        <button type="button" id="dashLoadSampleBtn" class="btn btn-secondary">
                            <i class="fas fa-wand-magic-sparkles"></i> Load Sample Content
                        </button>
                    </div>
                </article>

                <!-- 3-Column Highlights -->
                <div class="dashboard-grid-plus" style="grid-template-columns: repeat(3, 1fr); margin-top: 24px;">
                    <!-- Quick Section Navigation -->
                    <article class="card dashboard-card">
                        <div class="section-header">
                            <div>
                                <span class="badge badge-primary"><i class="fas fa-sitemap"></i> Document Outline</span>
                                <h4 style="margin-top: 6px;">Quick Section Navigation</h4>
                                <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 4px;">
                                    Access structured headings and jump directly into reading any paragraph.
                                </p>
                            </div>
                        </div>
                        <div id="outlinePanel" class="outline-panel" style="max-height: 200px; overflow-y: auto;">
                            <p class="empty-copy">Document outline appears here once text is loaded.</p>
                        </div>
                    </article>

                    <!-- Native Dialects -->
                    <article class="card dashboard-card">
                        <div class="section-header">
                            <div>
                                <span class="badge badge-primary"><i class="fas fa-earth-americas"></i> Regional Accents</span>
                                <h4 style="margin-top: 6px;">Native Dialects</h4>
                                <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 4px;">
                                    Voices dynamically filtered across native regional locales:
                                </p>
                            </div>
                        </div>
                        <div style="display: flex; flex-direction: column; gap: 8px; font-size: 0.88rem;">
                            <div style="display:flex; justify-content:space-between; padding: 6px 0; border-bottom: 1px solid var(--border-light);">
                                <span><strong>English</strong></span>
                                <span style="color:var(--text-muted);">US, UK, India, Australia, Canada</span>
                            </div>
                            <div style="display:flex; justify-content:space-between; padding: 6px 0; border-bottom: 1px solid var(--border-light);">
                                <span><strong>Spanish</strong></span>
                                <span style="color:var(--text-muted);">Spain, Mexico, Argentina</span>
                            </div>
                            <div style="display:flex; justify-content:space-between; padding: 6px 0; border-bottom: 1px solid var(--border-light);">
                                <span><strong>Italian</strong></span>
                                <span style="color:var(--text-muted);">Italy, Switzerland</span>
                            </div>
                            <div style="display:flex; justify-content:space-between; padding: 6px 0;">
                                <span><strong>Arabic &amp; Hindi</strong></span>
                                <span style="color:var(--text-muted);">Saudi Arabia, UAE, India</span>
                            </div>
                        </div>
                    </article>

                    <!-- Zero Telemetry Privacy -->
                    <article class="card dashboard-card">
                        <div class="section-header">
                            <div>
                                <span class="badge badge-primary"><i class="fas fa-shield-halved"></i> Privacy Engine</span>
                                <h4 style="margin-top: 6px;">Zero Server Telemetry</h4>
                                <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 4px;">
                                    100% in-browser WebAssembly execution. Documents never leave your device. Notes, accounts, and speech dictionaries persist in private local storage.
                                </p>
                            </div>
                        </div>
                        <div style="display: flex; flex-direction: column; gap: 8px; font-size: 0.88rem; margin-top: 6px;">
                            <div style="display: flex; align-items: center; gap: 8px; color: var(--flutter-blue-dark); font-weight: 600;">
                                <i class="fas fa-check-circle" style="color: #10B981;"></i> Client-Side Go WASM Binary
                            </div>
                            <div style="display: flex; align-items: center; gap: 8px; color: var(--flutter-blue-dark); font-weight: 600;">
                                <i class="fas fa-check-circle" style="color: #10B981;"></i> 17+ In-Browser File Parsers
                            </div>
                            <div style="display: flex; align-items: center; gap: 8px; color: var(--flutter-blue-dark); font-weight: 600;">
                                <i class="fas fa-check-circle" style="color: #10B981;"></i> Offline-Ready Static Architecture
                            </div>
                        </div>
                    </article>
                </div>
            </section>
{{end}}