{{define "studio"}}
            <!-- 3. STUDIO & TELEMETRY VIEW -->
            <section id="studioView" class="workspace-view">
                <!-- Live Teleprompter Deck -->
                <article class="teleprompter-card">
                    <div class="teleprompter-toolbar">
                        <div>
                            <span class="badge badge-primary"><i class="fas fa-tower-broadcast"></i> Live Teleprompter Deck</span>
                            <h2 style="font-size: 1.45rem; font-weight: 800; margin: 6px 0 0; color: var(--text-primary);">Visual Speech Teleprompter</h2>
                        </div>
                        <div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
                            <span id="teleprompterMeta" class="badge badge-info">Standby</span>
                            <div style="display: flex; align-items: center; gap: 8px;">
                                <label style="font-size: 0.8rem; font-weight: 600; color: var(--text-muted);">Font</label>
                                <input type="range" id="teleprompterFontSlider" min="20" max="52" value="28" style="width: 80px;">
                            </div>
                            <div style="display: flex; gap: 4px;">
                                <button type="button" id="teleprompterThemeDark" class="btn-icon" title="Dark Studio"><i class="fas fa-moon"></i></button>
                                <button type="button" id="teleprompterThemeLight" class="btn-icon" title="Paper Light"><i class="fas fa-sun"></i></button>
                                <button type="button" id="teleprompterThemeContrast" class="btn-icon" title="Neon Contrast"><i class="fas fa-circle-half-stroke"></i></button>
                            </div>
                        </div>
                    </div>

                    <!-- Live Teleprompter Stage Screen -->
                    <div id="teleprompterStage" class="teleprompter-stage theme-dark">
                        <div id="teleprompterContent" class="teleprompter-content">
                            <p class="teleprompter-empty">Load a document and press Start to run the Teleprompter Deck.</p>
                        </div>
                    </div>

                    <!-- Teleprompter Direct Audio Controls -->
                    <div class="teleprompter-actions">
                        <button id="teleStartBtn" class="btn btn-primary btn-lg" type="button"><i class="fas fa-play"></i> Start Teleprompter</button>
                        <button id="telePauseBtn" class="btn btn-secondary btn-lg" type="button"><i class="fas fa-pause"></i> Pause</button>
                        <button id="teleResumeBtn" class="btn btn-secondary btn-lg" type="button"><i class="fas fa-play-circle"></i> Resume</button>
                        <button id="teleStopBtn" class="btn btn-danger btn-lg" type="button"><i class="fas fa-stop"></i> Stop</button>
                    </div>
                </article>

                <div class="dashboard-grid-plus" style="grid-template-columns: 1.15fr 0.85fr; margin-top: 24px;">
                    <!-- Custom Pronunciation Lexicon -->
                    <article class="card lexicon-card">
                        <div class="section-header">
                            <div>
                                <span class="badge badge-primary"><i class="fas fa-spell-check"></i> Custom Pronunciation Lexicon</span>
                                <h3 style="margin-top: 6px;">Phonetic Rule Dictionary</h3>
                                <p style="font-size: 0.85rem; color: var(--text-muted); margin: 4px 0 0;">
                                    Override how the speech engine pronounces acronyms, abbreviations, and technical terms.
                                </p>
                            </div>
                        </div>

                        <!-- Add Rule Form -->
                        <div class="lexicon-form">
                            <div class="form-group" style="margin: 0;">
                                <label for="lexiconTerm">Original Term</label>
                                <input type="text" id="lexiconTerm" class="form-input" placeholder="e.g. WASM or SQL">
                            </div>
                            <div class="form-group" style="margin: 0;">
                                <label for="lexiconSpoken">Pronounced As</label>
                                <input type="text" id="lexiconSpoken" class="form-input" placeholder="e.g. Waz-um or Sequel">
                            </div>
                            <button type="button" id="addLexiconBtn" class="btn btn-primary"><i class="fas fa-plus"></i> Add Rule</button>
                            <button type="button" id="loadLexiconPresetsBtn" class="btn btn-secondary" title="Load standard tech presets"><i class="fas fa-bolt"></i> Presets</button>
                        </div>

                        <!-- Rules Table -->
                        <div style="max-height: 240px; overflow-y: auto;">
                            <table class="lexicon-table">
                                <thead>
                                    <tr>
                                        <th>Term</th>
                                        <th>Phonetic Form</th>
                                        <th style="text-align: right;">Action</th>
                                    </tr>
                                </thead>
                                <tbody id="lexiconTableBody">
                                    <tr><td colspan="3" style="text-align:center;color:var(--text-muted);padding:14px;">Loading rules...</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </article>

                    <!-- Heavy Feature: Linguistic Readability & Subtitle Studio -->
                    <article class="card telemetry-card">
                        <div class="section-header">
                            <div>
                                <span class="badge badge-info"><i class="fas fa-microchip"></i> Computational Telemetry</span>
                                <h3 style="margin-top: 6px;">Readability &amp; Subtitle Studio</h3>
                                <p style="font-size: 0.85rem; color: var(--text-muted); margin: 4px 0 0;">
                                    Real-time algorithmic cadence metrics &amp; subtitle generator for video creators.
                                </p>
                            </div>
                        </div>

                        <!-- Readability Metrics -->
                        <div class="insight-grid" style="grid-template-columns: 1fr 1fr; gap: 12px;">
                            <div class="insight-tile">
                                <span class="insight-label">Flesch Reading Ease</span>
                                <strong id="fleschScore">--</strong>
                                <span id="fleschBadge" class="badge badge-primary" style="align-self: flex-start; margin-top: 4px;">No Document</span>
                            </div>
                            <div class="insight-tile">
                                <span class="insight-label">Gunning Fog Index</span>
                                <strong id="gunningFogScore">--</strong>
                                <span style="font-size: 0.78rem; color: var(--text-muted); margin-top: 4px;">Grade Level</span>
                            </div>
                            <div class="insight-tile">
                                <span class="insight-label">Total Syllables</span>
                                <strong id="syllableCount" style="font-size: 1.15rem;">0 syllables</strong>
                            </div>
                            <div class="insight-tile">
                                <span class="insight-label">Word Complexity</span>
                                <strong id="complexWordCount" style="font-size: 1.15rem;">0 complex</strong>
                            </div>
                        </div>

                        <!-- Cadence Comparison -->
                        <div>
                            <span class="field-title" style="margin-bottom: 8px; display: block;">Speaking Duration by Cadence</span>
                            <div class="cadence-comparison-grid">
                                <div class="cadence-pill-card">
                                    <span>Presentation (125 WPM)</span>
                                    <strong id="pacePresTime">0s</strong>
                                </div>
                                <div class="cadence-pill-card">
                                    <span>Conversational (150 WPM)</span>
                                    <strong id="paceNormalTime">0s</strong>
                                </div>
                                <div class="cadence-pill-card">
                                    <span>Quick Skim (180 WPM)</span>
                                    <strong id="paceFastTime">0s</strong>
                                </div>
                            </div>
                        </div>

                        <!-- Subtitle & Caption Exporters -->
                        <div style="border-top: 1px solid var(--border-light); padding-top: 14px; margin-top: 4px;">
                            <span class="field-title" style="margin-bottom: 4px; display: block;">Export Narration Subtitles</span>
                            <p style="font-size: 0.82rem; color: var(--text-muted); margin: 0 0 10px;">
                                Export timestamped captions directly into Premiere Pro, DaVinci Resolve, CapCut, or YouTube.
                            </p>
                            <div class="export-btn-group">
                                <button type="button" id="exportSrtBtn" class="btn btn-primary btn-sm">
                                    <i class="fas fa-closed-captioning"></i> Export Subtitles (.SRT)
                                </button>
                                <button type="button" id="exportVttBtn" class="btn btn-secondary btn-sm">
                                    <i class="fas fa-file-lines"></i> Export WebVTT (.VTT)
                                </button>
                            </div>
                        </div>
                    </article>
                </div>
            </section>
{{end}}