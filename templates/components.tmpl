/* ========== COMPONENTS.CSS ========== */
/* LEXIO - Flutter & Material 3 Inspired Design System */

:root {
    /* Flutter Brand Palette */
    --flutter-blue-dark: #02569B;
    --flutter-blue: #0175C2;
    --flutter-blue-light: #0468D7;
    --flutter-cyan: #13B9FD;
    --flutter-cyan-light: #E0F2FE;
    --flutter-purple: #7C3AED;

    /* Semantic Primary Gradients */
    --gradient-primary: linear-gradient(135deg, #02569B 0%, #0468D7 60%, #13B9FD 100%);
    --gradient-banner: linear-gradient(90deg, #1D72FE 0%, #0468D7 40%, #7C3AED 100%);
    --gradient-soft: linear-gradient(135deg, #F0F7FF 0%, #E0F2FE 100%);

    /* Light Theme Neutral Surfaces */
    --bg-canvas: #F8FAFD;
    --bg-surface: #FFFFFF;
    --bg-surface-hover: #F1F5F9;
    --bg-subtle: #F4F7FA;
    --bg-card: #FFFFFF;

    /* Borders & Dividers */
    --border-light: #E8EEF5;
    --border-base: #E2E8F0;
    --border-focus: #0468D7;

    /* Typography Slate Palette */
    --text-primary: #0F172A;
    --text-secondary: #334155;
    --text-muted: #64748B;
    --text-subtle: #94A3B8;

    /* Semantic Accents */
    --success: #059669;
    --success-bg: #ECFDF5;
    --success-border: #A7F3D0;

    --warning: #D97706;
    --warning-bg: #FFFBEB;
    --warning-border: #FDE68A;

    --error: #DC2626;
    --error-bg: #FEF2F2;
    --error-border: #FECACA;

    --info: #0284C7;
    --info-bg: #F0F9FF;
    --info-border: #BAE6FD;

    /* Flutter Radii */
    --radius-sm: 8px;
    --radius-md: 12px;
    --radius-lg: 16px;
    --radius-xl: 20px;
    --radius-2xl: 24px;
    --radius-pill: 9999px;

    /* Elevation Shadows */
    --shadow-xs: 0 1px 2px rgba(15, 23, 42, 0.04);
    --shadow-sm: 0 1px 3px rgba(15, 23, 42, 0.05), 0 1px 2px rgba(15, 23, 42, 0.03);
    --shadow-md: 0 4px 12px -2px rgba(2, 86, 155, 0.06), 0 2px 4px -1px rgba(15, 23, 42, 0.03);
    --shadow-lg: 0 10px 25px -4px rgba(2, 86, 155, 0.08), 0 4px 6px -2px rgba(15, 23, 42, 0.03);
    --shadow-xl: 0 20px 35px -5px rgba(2, 86, 155, 0.12), 0 8px 10px -3px rgba(15, 23, 42, 0.04);

    /* Spacing */
    --space-1: 4px;
    --space-2: 8px;
    --space-3: 12px;
    --space-4: 16px;
    --space-5: 20px;
    --space-6: 24px;
    --space-8: 32px;
    --space-10: 40px;

    /* Transitions */
    --transition-fast: 150ms cubic-bezier(0.4, 0, 0.2, 1);
    --transition-base: 220ms cubic-bezier(0.4, 0, 0.2, 1);
    --transition-slow: 350ms cubic-bezier(0.4, 0, 0.2, 1);

    /* Fonts */
    --font-sans: 'Plus Jakarta Sans', 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

/* ===== BASE RESETS & TYPOGRAPHY ===== */
*, *::before, *::after {
    box-sizing: border-box;
}

body {
    font-family: var(--font-sans);
    color: var(--text-primary);
    background-color: var(--bg-canvas);
    margin: 0;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
}

/* ===== BUTTONS ===== */
.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: 10px 22px;
    border: 1px solid transparent;
    border-radius: var(--radius-pill);
    font-family: var(--font-sans);
    font-size: 0.92rem;
    font-weight: 600;
    cursor: pointer;
    text-decoration: none;
    transition: all var(--transition-base);
    white-space: nowrap;
    user-select: none;
    line-height: 1.25;
}

.btn:focus-visible {
    outline: 2px solid var(--flutter-blue-light);
    outline-offset: 2px;
}

.btn-primary {
    background: var(--flutter-blue-light);
    color: #FFFFFF;
    box-shadow: 0 4px 14px rgba(4, 104, 215, 0.25);
}

.btn-primary:hover {
    background: #02569B;
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(2, 86, 155, 0.32);
    color: #FFFFFF;
}

.btn-primary:active {
    transform: translateY(0);
}

.btn-secondary {
    background-color: #FFFFFF;
    color: var(--text-secondary);
    border: 1px solid var(--border-base);
    box-shadow: var(--shadow-xs);
}

.btn-secondary:hover {
    background-color: var(--bg-surface-hover);
    border-color: #CBD5E1;
    color: var(--text-primary);
    transform: translateY(-1px);
}

.btn-outline {
    background-color: transparent;
    color: var(--flutter-blue-light);
    border: 1.5px solid var(--flutter-blue-light);
}

.btn-outline:hover {
    background-color: var(--flutter-cyan-light);
    color: var(--flutter-blue-dark);
}

.btn-danger {
    background-color: var(--error-bg);
    color: var(--error);
    border: 1px solid var(--error-border);
}

.btn-danger:hover {
    background-color: #FEE2E2;
    color: #B91C1C;
}

.btn-success {
    background-color: var(--success-bg);
    color: var(--success);
    border: 1px solid var(--success-border);
}

.btn-success:hover {
    background-color: #D1FAE5;
}

.btn-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    padding: 0;
    border-radius: var(--radius-pill);
    background-color: #FFFFFF;
    color: var(--text-secondary);
    border: 1px solid var(--border-base);
    cursor: pointer;
    transition: all var(--transition-base);
}

.btn-icon:hover {
    background-color: var(--bg-surface-hover);
    color: var(--flutter-blue-light);
    border-color: #CBD5E1;
}

.btn-pill {
    border-radius: var(--radius-pill);
}

.btn-block {
    width: 100%;
}

.btn-sm {
    padding: 7px 16px;
    font-size: 0.84rem;
}

.btn-lg {
    padding: 13px 28px;
    font-size: 1.05rem;
}

.btn:disabled,
.btn[disabled] {
    opacity: 0.55;
    cursor: not-allowed;
    pointer-events: none;
    box-shadow: none !important;
    transform: none !important;
}

/* ===== CARDS ===== */
.card {
    background-color: var(--bg-card);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    box-shadow: var(--shadow-sm);
    transition: box-shadow var(--transition-base), border-color var(--transition-base);
}

.card:hover {
    border-color: #CBD5E1;
    box-shadow: var(--shadow-md);
}

.card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border-light);
}

.card-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
}

.card-subtitle {
    font-size: 0.88rem;
    color: var(--text-muted);
    margin-top: 4px;
}

/* ===== BADGES & PILLS ===== */
.badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 12px;
    border-radius: var(--radius-pill);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    line-height: 1.4;
}

.badge-primary {
    background-color: var(--flutter-cyan-light);
    color: var(--flutter-blue-dark);
    border: 1px solid #BAE6FD;
}

.badge-success {
    background-color: var(--success-bg);
    color: var(--success);
    border: 1px solid var(--success-border);
}

.badge-warning {
    background-color: var(--warning-bg);
    color: var(--warning);
    border: 1px solid var(--warning-border);
}

.badge-error {
    background-color: var(--error-bg);
    color: var(--error);
    border: 1px solid var(--error-border);
}

.badge-info {
    background-color: var(--info-bg);
    color: var(--info);
    border: 1px solid var(--info-border);
}

.badge-premium {
    background: var(--gradient-primary);
    color: #FFFFFF;
    border: none;
    box-shadow: 0 2px 8px rgba(4, 104, 215, 0.25);
}

/* ===== FORM CONTROLS ===== */
.form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: var(--space-4);
    text-align: left;
}

.form-group label,
label.field-title {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-secondary);
}

.form-input,
.source-input,
.notes-input,
.assistant-input {
    width: 100%;
    padding: 11px 16px;
    font-family: var(--font-sans);
    font-size: 0.94rem;
    color: var(--text-primary);
    background-color: #FFFFFF;
    border: 1.5px solid var(--border-base);
    border-radius: var(--radius-md);
    transition: border-color var(--transition-base), box-shadow var(--transition-base);
}

.form-input:focus,
.source-input:focus,
.notes-input:focus,
.assistant-input:focus {
    outline: none;
    border-color: var(--flutter-blue-light);
    box-shadow: 0 0 0 3px rgba(4, 104, 215, 0.12);
}

.form-input::placeholder {
    color: var(--text-subtle);
}

.form-help {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-top: 4px;
}

/* ===== TOGGLES & SWITCHES ===== */
.toggle-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 14px;
    background-color: var(--bg-subtle);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: background-color var(--transition-fast);
}

.toggle-row:hover {
    background-color: #EBF2FA;
}

.toggle-row span {
    display: flex;
    flex-direction: column;
    gap: 2px;
}

.toggle-row strong {
    font-size: 0.88rem;
    color: var(--text-primary);
}

.toggle-row small {
    font-size: 0.78rem;
    color: var(--text-muted);
}

.toggle-row input[type="checkbox"] {
    appearance: none;
    width: 44px;
    height: 24px;
    background-color: #CBD5E1;
    border-radius: var(--radius-pill);
    position: relative;
    cursor: pointer;
    outline: none;
    transition: background-color var(--transition-base);
    flex-shrink: 0;
}

.toggle-row input[type="checkbox"]::after {
    content: '';
    position: absolute;
    top: 3px;
    left: 3px;
    width: 18px;
    height: 18px;
    background-color: #FFFFFF;
    border-radius: 50%;
    transition: transform var(--transition-base);
    box-shadow: var(--shadow-xs);
}

.toggle-row input[type="checkbox"]:checked {
    background-color: var(--flutter-blue-light);
}

.toggle-row input[type="checkbox"]:checked::after {
    transform: translateX(20px);
}

/* ===== STATUS & TOASTS ===== */
.status-indicator {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    font-size: 0.82rem;
    font-weight: 600;
    background: #FFFFFF;
    border: 1px solid var(--border-base);
    color: var(--text-secondary);
}

.status-floating {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 100;
    box-shadow: var(--shadow-lg);
    opacity: 0;
    pointer-events: none;
    transform: translateY(12px);
    transition: all var(--transition-base);
}

.status-floating.visible {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
}