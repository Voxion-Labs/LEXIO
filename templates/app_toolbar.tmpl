{{define "app_toolbar"}}
        <!-- Sub-Toolbar with Segmented View Switcher -->
        <section class="workspace-toolbar">
            <div class="workspace-tabs" role="tablist" aria-label="Workspace Views">
                <button class="workspace-tab active" type="button" data-view="dashboardView"><i class="fas fa-table-columns"></i> Dashboard</button>
                <button class="workspace-tab" type="button" data-view="readerView"><i class="fas fa-file-waveform"></i> Reader</button>
                <button class="workspace-tab" type="button" data-view="studioView"><i class="fas fa-tower-broadcast"></i> Studio &amp; Telemetry</button>
            </div>
            <div class="workspace-toolbar-meta">
                <span class="meta-chip">Engine: <strong>Go WebAssembly</strong></span>
                <span class="meta-chip">Telemetry: <strong>100% Client-Side</strong></span>
                <span class="meta-chip">Status: <strong>Ready</strong></span>
            </div>
        </section>
{{end}}